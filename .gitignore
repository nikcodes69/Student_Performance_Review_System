# Byte-compiled Python files
__pycache__/
*.py[cod]

# Virtual environments
venv/
env/
.venv/

# The database is generated locally by running database/db_setup.py --
# we don't commit it, since it's build output, not source code.
database/*.db

# Log files are generated at runtime, not source code.
logs/*.log

# Trained ML models and their metadata ARE committed (see git history --
# this was gitignored during local-only development, since they're build
# output regenerable from ml/model_training.ipynb, not written by hand).
# They're tracked now because the deployed Streamlit Community Cloud app
# has no way to run the notebook itself -- it can only load these files,
# never train them (see modules/ml_predictions.py's module docstring) --
# so without committing them, every ML prediction page on the live
# deployment would show a "model not found" warning. They're small
# (under 15 KB total) and deterministic (same config.RANDOM_STATE seed),
# so re-running the notebook and committing the new files is always safe.

# Jupyter Notebook checkpoint files
.ipynb_checkpoints/

# pytest cache
.pytest_cache/
.cache/

# OS-specific junk files
.DS_Store
Thumbs.db

# Editor/IDE settings
.vscode/
.idea/

# Streamlit secrets (Turso database URL + auth token, and anything else
# sensitive) -- NEVER commit this. Streamlit Community Cloud gets its own
# copy of these values pasted into its web UI, not from this file.
.streamlit/secrets.toml
